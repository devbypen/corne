/*
 * Miryoku layout for a 5-column (3x5+3, 36 key) Corne.
 * Based on https://github.com/manna-harbour/miryoku_zmk (default options),
 * with Gallium alphas on Base/Tap and QWERTY on Extra.
 *
 * Key order in every layer:
 *   10 keys per row x 3 rows, then 6 thumb keys (left outer -> right outer).
 */

// Mouse key speed (Miryoku values), must come before the pointing includes
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1250
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

#include <behaviors.dtsi>
#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE   0
#define EXTRA  1
#define TAP    2
#define BUTTON 3
#define NAV    4
#define MOUSE  5
#define MEDIA  6
#define NUM    7
#define SYM    8
#define FUN    9

// Clipboard keys. Miryoku default (works on Linux). For Windows use
// LC(Y) LC(V) LC(C) LC(X) LC(Z); for macOS use LS(LG(Z)) LG(V) LG(C) LG(X) LG(Z).
#define U_RDO &kp K_AGAIN
#define U_PST &kp LS(INS)
#define U_CPY &kp LC(INS)
#define U_CUT &kp LS(DEL)
#define U_UND &kp K_UNDO

#define U_NA &none // present but not available for use
#define U_NU &none // available but not used

&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <1500>;
    delay-ms = <0>;
};

// Double-tap guard: a single tap does nothing, a double tap runs the binding.
#define DOUBLE_TAP_GUARD(NAME, BINDING) \
    NAME: NAME { \
        compatible = "zmk,behavior-tap-dance"; \
        #binding-cells = <0>; \
        tapping-term-ms = <200>; \
        bindings = <&none>, <BINDING>; \
    };

// Normal binding, or a different one while Shift is held.
#define SHIFT_FUNCTION(NAME, BINDING, SHIFT_BINDING) \
    NAME: NAME { \
        compatible = "zmk,behavior-mod-morph"; \
        #binding-cells = <0>; \
        bindings = <BINDING>, <SHIFT_BINDING>; \
        mods = <(MOD_LSFT|MOD_RSFT)>; \
    };

// Tap: select BT profile. Shift + tap: select and clear that profile.
#define BT_SEL_CLR(N) \
    u_bt_sel_clr_##N: u_bt_sel_clr_##N { \
        compatible = "zmk,behavior-macro"; \
        #binding-cells = <0>; \
        wait-ms = <0>; \
        bindings = <&bt BT_SEL N &bt BT_CLR>; \
    };

/ {
    macros {
        BT_SEL_CLR(0)
        BT_SEL_CLR(1)
        BT_SEL_CLR(2)
        BT_SEL_CLR(3)
        BT_SEL_CLR(4)
    };

    behaviors {
        u_mt: u_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        u_lt: u_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        DOUBLE_TAP_GUARD(u_to_base,  &to BASE)
        DOUBLE_TAP_GUARD(u_to_extra, &to EXTRA)
        DOUBLE_TAP_GUARD(u_to_tap,   &to TAP)
        DOUBLE_TAP_GUARD(u_to_nav,   &to NAV)
        DOUBLE_TAP_GUARD(u_to_mouse, &to MOUSE)
        DOUBLE_TAP_GUARD(u_to_media, &to MEDIA)
        DOUBLE_TAP_GUARD(u_to_num,   &to NUM)
        DOUBLE_TAP_GUARD(u_to_sym,   &to SYM)
        DOUBLE_TAP_GUARD(u_to_fun,   &to FUN)

        SHIFT_FUNCTION(u_bt_sel_0, &bt BT_SEL 0, &u_bt_sel_clr_0)
        SHIFT_FUNCTION(u_bt_sel_1, &bt BT_SEL 1, &u_bt_sel_clr_1)
        SHIFT_FUNCTION(u_bt_sel_2, &bt BT_SEL 2, &u_bt_sel_clr_2)
        SHIFT_FUNCTION(u_bt_sel_3, &bt BT_SEL 3, &u_bt_sel_clr_3)
        SHIFT_FUNCTION(u_out_tog,  &out OUT_TOG, &out OUT_USB)
        SHIFT_FUNCTION(u_caps_word, &caps_word,  &kp CAPS)
    };

    combos {
        compatible = "zmk,combos";

        // Gallium has no '/' on the 30 alpha keys: press ' + ; together.
        combo_slash {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&kp SLASH>;
            layers = <BASE TAP>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            // Gallium with home row mods (GUI/Alt/Ctrl/Shift), layer-taps on thumbs.
            // '/' is the combo ' + ; (see combos below).
            bindings = <
&kp B            &kp L            &kp D             &kp C             &kp V        &kp J        &kp Y             &kp O             &kp U              &kp COMMA
&u_mt LGUI N     &u_mt LALT R     &u_mt LCTRL T     &u_mt LSHFT S     &kp G        &kp P        &u_mt LSHFT H     &u_mt LCTRL A     &u_mt LALT E       &u_mt LGUI I
&u_lt BUTTON X   &u_mt RALT Q     &kp M             &kp W             &kp Z        &kp K        &kp F             &kp SQT           &u_mt RALT SEMI    &u_lt BUTTON DOT
                                  &u_lt MEDIA ESC   &u_lt NAV SPACE   &u_lt MOUSE TAB          &u_lt SYM RET     &u_lt NUM BSPC    &u_lt FUN DEL
            >;
        };

        extra_layer {
            display-name = "Extra";
            // QWERTY alternative base
            bindings = <
&kp Q            &kp W            &kp E             &kp R             &kp T        &kp Y        &kp U             &kp I             &kp O              &kp P
&u_mt LGUI A     &u_mt LALT S     &u_mt LCTRL D     &u_mt LSHFT F     &kp G        &kp H        &u_mt LSHFT J     &u_mt LCTRL K     &u_mt LALT L       &u_mt LGUI SQT
&u_lt BUTTON Z   &u_mt RALT X     &kp C             &kp V             &kp B        &kp N        &kp M             &kp COMMA         &u_mt RALT DOT     &u_lt BUTTON SLASH
                                  &u_lt MEDIA ESC   &u_lt NAV SPACE   &u_lt MOUSE TAB          &u_lt SYM RET     &u_lt NUM BSPC    &u_lt FUN DEL
            >;
        };

        tap_layer {
            display-name = "Tap";
            // Gallium without any hold behaviors (for gaming)
            bindings = <
&kp B     &kp L     &kp D     &kp C       &kp V          &kp J     &kp Y     &kp O       &kp U     &kp COMMA
&kp N     &kp R     &kp T     &kp S       &kp G          &kp P     &kp H     &kp A       &kp E     &kp I
&kp X     &kp Q     &kp M     &kp W       &kp Z          &kp K     &kp F     &kp SQT     &kp SEMI  &kp DOT
                    &kp ESC   &kp SPACE   &kp TAB        &kp RET   &kp BSPC  &kp DEL
            >;
        };

        button_layer {
            display-name = "Button";
            bindings = <
U_UND      U_CUT      U_CPY       U_PST       U_RDO          U_RDO      U_PST       U_CPY       U_CUT      U_UND
&kp LGUI   &kp LALT   &kp LCTRL   &kp LSHFT   U_NA           U_NA       &kp LSHFT   &kp LCTRL   &kp LALT   &kp LGUI
U_UND      U_CUT      U_CPY       U_PST       U_RDO          U_RDO      U_PST       U_CPY       U_CUT      U_UND
                      &mkp MB3    &mkp MB1    &mkp MB2       &mkp MB2   &mkp MB1    &mkp MB3
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
&bootloader   &u_to_tap   &u_to_extra   &u_to_base   U_NA        U_RDO          U_PST      U_CPY       U_CUT      U_UND
&kp LGUI      &kp LALT    &kp LCTRL     &kp LSHFT    U_NA        &u_caps_word   &kp LEFT   &kp DOWN    &kp UP     &kp RIGHT
U_NA          &kp RALT    &u_to_num     &u_to_nav    U_NA        &kp INS        &kp HOME   &kp PG_DN   &kp PG_UP  &kp END
                          U_NA          U_NA         U_NA        &kp RET        &kp BSPC   &kp DEL
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&bootloader   &u_to_tap   &u_to_extra   &u_to_base    U_NA       U_RDO      U_PST            U_CPY            U_CUT          U_UND
&kp LGUI      &kp LALT    &kp LCTRL     &kp LSHFT     U_NA       U_NU       &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP   &mmv MOVE_RIGHT
U_NA          &kp RALT    &u_to_sym     &u_to_mouse   U_NA       U_NU       &msc SCRL_LEFT   &msc SCRL_DOWN   &msc SCRL_UP   &msc SCRL_RIGHT
                          U_NA          U_NA          U_NA       &mkp MB2   &mkp MB1         &mkp MB3
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
&bootloader   &u_to_tap   &u_to_extra   &u_to_base    U_NA       &rgb_ug RGB_TOG     &rgb_ug RGB_EFF   &rgb_ug RGB_HUI   &rgb_ug RGB_SAI   &rgb_ug RGB_BRI
&kp LGUI      &kp LALT    &kp LCTRL     &kp LSHFT     U_NA       &ext_power EP_TOG   &kp C_PREV        &kp C_VOL_DN      &kp C_VOL_UP      &kp C_NEXT
U_NA          &kp RALT    &u_to_fun     &u_to_media   U_NA       &u_out_tog          &u_bt_sel_0       &u_bt_sel_1       &u_bt_sel_2       &u_bt_sel_3
                          U_NA          U_NA          U_NA       &kp C_STOP          &kp C_PP          &kp C_MUTE
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
&kp LBKT    &kp N7   &kp N8      &kp N9      &kp RBKT      U_NA   &u_to_base   &u_to_extra   &u_to_tap   &bootloader
&kp SEMI    &kp N4   &kp N5      &kp N6      &kp EQUAL     U_NA   &kp LSHFT    &kp LCTRL     &kp LALT    &kp LGUI
&kp GRAVE   &kp N1   &kp N2      &kp N3      &kp BSLH      U_NA   &u_to_num    &u_to_nav     &kp RALT    U_NA
                     &kp DOT     &kp N0      &kp MINUS     U_NA   U_NA         U_NA
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
&kp LBRC    &kp AMPS   &kp ASTRK   &kp LPAR    &kp RBRC      U_NA   &u_to_base   &u_to_extra   &u_to_tap   &bootloader
&kp COLON   &kp DLLR   &kp PRCNT   &kp CARET   &kp PLUS      U_NA   &kp LSHFT    &kp LCTRL     &kp LALT    &kp LGUI
&kp TILDE   &kp EXCL   &kp AT      &kp HASH    &kp PIPE      U_NA   &u_to_sym    &u_to_mouse   &kp RALT    U_NA
                       &kp LPAR    &kp RPAR    &kp UNDER     U_NA   U_NA         U_NA
            >;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
&kp F12   &kp F7   &kp F8      &kp F9      &kp PSCRN         U_NA   &u_to_base   &u_to_extra   &u_to_tap   &bootloader
&kp F11   &kp F4   &kp F5      &kp F6      &kp SLCK          U_NA   &kp LSHFT    &kp LCTRL     &kp LALT    &kp LGUI
&kp F10   &kp F1   &kp F2      &kp F3      &kp PAUSE_BREAK   U_NA   &u_to_fun    &u_to_media   &kp RALT    U_NA
                   &kp K_APP   &kp SPACE   &kp TAB           U_NA   U_NA         U_NA
            >;
        };
    };
};
